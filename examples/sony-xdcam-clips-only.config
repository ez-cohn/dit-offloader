# Example: Sony XDCAM cards, clips only, date folders as YYMMDD,
# audio takes renamed with track names and a RoomTone take,
# parallel copying and an ASC MHL history with xxh128 checksums, offloads after
# midnight filed under the previous day, Terminal alerts and an HTML report.
# For every setting described: dit-offloader init --print
DESTINATIONS=("offloadDrive")
MIN_DESTINATIONS=2
VIDEO_PATH='{project}-Media/11-Footage/{date}/CAM{cam}'
AUDIO_PATH='{project}-Media/12-Audio/{date}'
DATE_FORMAT='%y%m%d'
VIDEO_MODE="clips"
VIDEO_EXTENSIONS="mxf"
CLIP_FOLDERS=("XDROOT/Clip")
CAM_SOURCE="filename"
RENAME_CARD="yes"
AUDIO_RENAME="yes"
AUDIO_NAME='{date}-{project}-{take}-{track}'
AUDIO_ROOMTONE="ask"
AUDIO_TRACKS="Tr1=Tr1-OH Tr2=Tr2-Lav Tr3=Tr3-Desk Tr4=Tr4-Aud TrL_R=TrLR-Mix"
HASH_ALGO="xxh128"
COPY_MODE="parallel"
CHECKSUM_FILE="ascmhl"
SOURCE_RECHECK="yes"
SHOOT_DAY="cutoff"
DAY_STARTS_AT="05:00"
TERMINAL_ALERTS="bell title summary"
WATCH_ON_START="yes"
REPORT_FORMAT="html"
REPORT_PATH='{project}-Media/17-Reports'
